import random

while True:
    choice = input("Enter y/n you wanna play game?").lower()
    if choice == 'y':
        print("You chose Yes! ")
        choice1 = input("Roll the dice? (y/n): ").lower()
        if choice1 == 'y':
            dice = [(i, j) for i in range(1, 7) for j in range(1, 7)]
            print("You rolled:", random.choice(dice))
        elif choice1 == 'n':
            print("You chose not to roll the dice.")
            break
        else:
            print("Invalid option")
    elif choice == 'n':
        print("you chose No!")
    else:
        print(" Invalid Selection") 
